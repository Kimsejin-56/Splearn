<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_2.xsd"
        version="3.2">

    <access>FIELD</access>

    <mapped-superclass class="spring.splearn.domain.AbstractEntity">
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
        </attributes>
    </mapped-superclass>

    <entity class="spring.splearn.domain.member.Member">
        <table name="MEMBER">
            <unique-constraint name="UK_MEMBER_EMAIL_ADDRESS">
                <column-name>email_address</column-name>
            </unique-constraint>
            <unique-constraint name="UK_MEMBER_DETAIL_ID">
                <column-name>detail_id</column-name>
            </unique-constraint>
        </table>

        <attributes>
            <basic name="nickname">
                <column length="100" nullable="false"/>
            </basic>

            <basic name="passwordHash">
                <column length="200" nullable="false"/>
            </basic>

            <basic name="status">
                <column length="50" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>

            <one-to-one name="detail" fetch="LAZY">
                <join-column name="detail_id" referenced-column-name="id"/>
                <foreign-key name="FK_MEMBER_DETAIL_ID"/>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-one>

            <embedded name="email"/>
        </attributes>
    </entity>

    <entity class="spring.splearn.domain.member.MemberDetail">
        <table name="MEMBER_DETAIL">
            <unique-constraint name="UK_MEMBER_DETAIL_PROFILE_ADDRESS">
                <column-name>profile_address</column-name>
            </unique-constraint>
        </table>

        <attributes>
            <basic name="introduction">
                <column column-definition="TEXT"/>
            </basic>

            <basic name="registeredAt">
                <column nullable="false"/>
            </basic>

            <basic name="activatedAt"/>

            <basic name="deactivatedAt"/>

            <embedded name="profile"/>
        </attributes>
    </entity>

    <embeddable class="spring.splearn.domain.member.Profile">
        <attributes>
            <basic name="address">
                <column name="profile_address" length="20"/>
            </basic>
        </attributes>
    </embeddable>

    <embeddable class="spring.splearn.domain.shared.Email">
        <attributes>
            <basic name="address">
                <column name="email_address" length="150" nullable="false"/>
            </basic>
        </attributes>
    </embeddable>

</entity-mappings>
